<ContentPage
    x:Class="TriviaQuiz.App.Views.MainMenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TriviaQuiz.App.ViewModels"
    Title="Trivia Quiz">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            Text="Trivia Quiz"
            FontSize="36"
            HorizontalOptions="Center"
            FontAttributes="Bold" />

        <!-- Show "Continue" button only if there's a game to resume -->
        <Button
            Text="Continue"
            Command="{Binding ContinueCommand}"
            IsVisible="{Binding CanResume}" />

        <Button
            Text="Start New Game"
            Command="{Binding StartNewGameCommand}" />

        <Button
            Text="Statistics"
            Command="{Binding ShowStatisticsCommand}" />

        <Button
            Text="Exit"
            Command="{Binding ExitCommand}" />

    </VerticalStackLayout>

</ContentPage>
